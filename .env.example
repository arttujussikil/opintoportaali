# Database — use DB_HOST=db when running via Docker Compose, 127.0.0.1 otherwise
DB_HOST=db
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=testi5

# Flask
FLASK_SECRET=replace_with_a_long_random_string

# Admin user (seeded by database2.py on first start)
ADMIN_PASSWORD=change_me

# Email (optional — reservation confirmation emails)
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_SENDER=noreply@yourdomain.com
